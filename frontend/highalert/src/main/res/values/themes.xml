<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HighAlert" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.HighAlert.Alarm" parent="Theme.HighAlert">
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
